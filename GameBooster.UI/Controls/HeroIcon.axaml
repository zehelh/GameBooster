<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBooster.UI.Controls.HeroIcon">
    
    <Path x:Name="IconPath"
          Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Fill="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=White}"
          Stretch="Uniform"
          Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=16}"
          Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=16}"/>
    
</UserControl>
