<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBooster.UI.Controls.StatCard"
             x:DataType="controls:StatCard"
             x:Name="statCard"
             xmlns:controls="using:GameBooster.UI.Controls">

  <Border Background="#1A1A2E" 
          CornerRadius="8" 
          Padding="15"
          Margin="5"
          BorderBrush="#333" 
          BorderThickness="1">
    
    <StackPanel Spacing="8">
      <!-- Header -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding #statCard.Icon}" 
                   FontSize="18" 
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding #statCard.Label}" 
                   FontSize="14" 
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
      </StackPanel>
      
      <!-- Value -->
      <TextBlock Text="{Binding #statCard.Value}" 
                 FontSize="20" 
                 FontWeight="Bold" 
                 Foreground="{Binding #statCard.ValueColor}"
                 HorizontalAlignment="Center"/>
      
      <!-- Progress Bar (optional) -->
      <ProgressBar IsVisible="{Binding #statCard.ShowProgress}"
                   Value="{Binding #statCard.ProgressValue}"
                   Maximum="100"
                   Background="#333"
                   Foreground="{Binding #statCard.ProgressColor}"
                   Height="6"
                   CornerRadius="3"/>
      
      <!-- Sub Text -->
      <TextBlock Text="{Binding #statCard.SubText}" 
                 FontSize="12" 
                 Foreground="#888"
                 HorizontalAlignment="Center"
                 IsVisible="{Binding #statCard.HasSubText}"/>
    </StackPanel>
  </Border>
</UserControl>
