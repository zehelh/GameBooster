<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GameBooster.UI.Views.ServicesView">
    
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🛡️ Windows Services Management" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="White"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Manage Windows services and security settings" 
                           FontSize="14" Opacity="0.7" 
                           Foreground="#CCCCCC"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Windows Defender Panel -->
                <Border Grid.Column="0" 
                        Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛡️" FontSize="24"/>
                            <TextBlock Text="Windows Defender" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <TextBlock Text="Manage Windows Defender protection settings" 
                                   FontSize="12" Opacity="0.7"/>
                        
                        <!-- Defender Status -->
                        <Border Background="#0F0F23" CornerRadius="6" Padding="15"
                                IsVisible="{Binding HasDefenderStatus}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Protection Status" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Text="{Binding DefenderStatus.FormattedStatus}" 
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding DefenderStatus.StatusColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Last Check" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="{Binding DefenderStatus.LastCheck, StringFormat='HH:mm:ss'}" 
                                                   FontSize="10" Foreground="#AAAAAA"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Protection Details -->
                                <StackPanel Spacing="8">
                                    <!-- Real-time Protection -->
                                    <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Real-time Protection" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding DefenderStatus.RealTimeProtectionDescription}" 
                                                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DefenderStatus.RealTimeProtectionText}" 
                                                           FontSize="10" Foreground="{Binding DefenderStatus.RealTimeProtectionColor}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Toggle" 
                                                    Command="{Binding ToggleRealTimeProtectionCommand}"
                                                    Background="#333" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Cloud Protection -->
                                    <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cloud Protection" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding DefenderStatus.CloudProtectionDescription}" 
                                                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DefenderStatus.CloudProtectionText}" 
                                                           FontSize="10" Foreground="{Binding DefenderStatus.CloudProtectionColor}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Toggle" 
                                                    Command="{Binding ToggleCloudProtectionCommand}"
                                                    Background="#333" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Tamper Protection -->
                                    <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tamper Protection" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding DefenderStatus.TamperProtectionDescription}" 
                                                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DefenderStatus.TamperProtectionText}" 
                                                           FontSize="10" Foreground="{Binding DefenderStatus.TamperProtectionColor}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Toggle" 
                                                    Command="{Binding ToggleTamperProtectionCommand}"
                                                    Background="#333" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sample Submission -->
                                    <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sample Submission" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding DefenderStatus.SampleSubmissionDescription}" 
                                                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DefenderStatus.AutomaticSampleSubmissionText}" 
                                                           FontSize="10" Foreground="{Binding DefenderStatus.AutomaticSampleSubmissionColor}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Toggle" 
                                                    Command="{Binding ToggleSampleSubmissionCommand}"
                                                    Background="#333" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Defender Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{Binding DefenderStatus.ProtectionButtonText}" 
                                    Command="{Binding ToggleDefenderCommand}"
                                    Background="{Binding DefenderStatus.ProtectionButtonColor}"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    Padding="15,8"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"/>
                            
                            <Button Content="🔄 Refresh" 
                                    Command="{Binding RefreshCommand}"
                                    Background="#333" 
                                    Foreground="White"
                                    FontSize="12"
                                    Padding="15,8"
                                    CornerRadius="6"/>
                        </StackPanel>
                        
                        <!-- Elevation Warning -->
                        <Border Background="#FF4444" CornerRadius="6" Padding="10"
                                IsVisible="{Binding IsNotElevated}">
                            <TextBlock Text="⚠️ Administrator privileges required for service management" 
                                       FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Windows Services Panel -->
                <Border Grid.Column="1" 
                        Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1"
                        Margin="10,0,0,0">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚙️" FontSize="24"/>
                            <TextBlock Text="Windows Services" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <TextBlock Text="Manage important Windows services" 
                                   FontSize="12" Opacity="0.7"/>
                        
                        <!-- Services List -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F0F23" 
                                                Padding="12" 
                                                Margin="0,4" 
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               FontSize="12" 
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="10" 
                                                               Foreground="#AAAAAA"/>
                                                    <TextBlock Text="{Binding Status}" 
                                                               FontSize="10" 
                                                               Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                                                    <Button Content="▶️" 
                                                            Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"
                                                            Background="LightGreen"
                                                            Foreground="Black"
                                                            FontSize="10"
                                                            Padding="8,4"
                                                            CornerRadius="4"
                                                            IsEnabled="{Binding CanStart}"/>
                                                    
                                                    <Button Content="⏹️" 
                                                            Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"
                                                            Background="#FF4444"
                                                            Foreground="White"
                                                            FontSize="10"
                                                            Padding="8,4"
                                                            CornerRadius="4"
                                                            IsEnabled="{Binding CanStop}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="5">
                                                    <Button Content="✅" 
                                                            Command="{Binding DataContext.EnableServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"
                                                            Background="LightGreen"
                                                            Foreground="Black"
                                                            FontSize="10"
                                                            Padding="8,4"
                                                            CornerRadius="4"
                                                            IsEnabled="{Binding CanStart}"/>
                                                    
                                                    <Button Content="❌" 
                                                            Command="{Binding DataContext.DisableServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"
                                                            Background="#FFA500"
                                                            Foreground="Black"
                                                            FontSize="10"
                                                            Padding="8,4"
                                                            CornerRadius="4"
                                                            IsEnabled="{Binding CanStart}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Startup Programs Panel -->
            <Border Grid.Row="2" 
                    Background="#1A1A2E" 
                    CornerRadius="8" 
                    Padding="20"
                    BorderBrush="#333" 
                    BorderThickness="1"
                    Margin="0,20,0,0">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🚀" FontSize="20"/>
                        <TextBlock Text="Startup Programs" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="White"/>
                    </StackPanel>
                    
                    <TextBlock Text="Manage programs that start with Windows" 
                               FontSize="12" Opacity="0.7"/>
                    
                    <!-- Startup Programs List -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Enabled Programs -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="✅ Enabled Programs" 
                                           FontSize="12" FontWeight="Bold" 
                                           Foreground="LightGreen"/>
                                <ItemsControl ItemsSource="{Binding EnabledStartupPrograms}">
                                    <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F0F23" 
                                            Padding="12" 
                                            Margin="0,4" 
                                            CornerRadius="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding ExecutablePath}" 
                                                           FontSize="10" 
                                                           Foreground="#AAAAAA"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StartupType}" 
                                                           FontSize="10" 
                                                           Foreground="#666"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FileSizeFormatted}" 
                                                           FontSize="10" 
                                                           Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding StatusText}" 
                                                           FontSize="10" 
                                                           Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="2" 
                                                    Content="{Binding ToggleButtonText}" 
                                                    Command="{Binding DataContext.ToggleStartupProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{Binding ToggleButtonColor}"
                                                    Foreground="Black"
                                                    FontSize="10"
                                                    Padding="12,6"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <!-- Disabled Programs -->
                            <StackPanel Spacing="5">
                            <TextBlock Text="❌ Disabled Programs" 
                                       FontSize="12" FontWeight="Bold" 
                                       Foreground="#FF4444"/>
                            <ItemsControl ItemsSource="{Binding DisabledStartupPrograms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F0F23" 
                                                Padding="12" 
                                                Margin="0,4" 
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="12" 
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                    <TextBlock Text="{Binding ExecutablePath}" 
                                                               FontSize="10" 
                                                               Foreground="#AAAAAA"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StartupType}" 
                                                               FontSize="10" 
                                                               Foreground="#666"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FileSizeFormatted}" 
                                                               FontSize="10" 
                                                               Foreground="#AAAAAA"/>
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               FontSize="10" 
                                                               Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                                
                                                <Button Grid.Column="2" 
                                                        Content="{Binding ToggleButtonText}" 
                                                        Command="{Binding DataContext.ToggleStartupProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{Binding ToggleButtonColor}"
                                                        Foreground="Black"
                                                        FontSize="10"
                                                        Padding="12,6"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
