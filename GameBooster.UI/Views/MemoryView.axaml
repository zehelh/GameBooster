<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GameBooster.UI.Views.MemoryView">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🧠 Memory Management" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Monitor and optimize system memory usage" 
                       FontSize="14" Opacity="0.7" 
                       Foreground="#CCCCCC"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Memory Management Panel -->
            <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,10,0">
                
                <!-- Memory Status Card -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📊" FontSize="24"/>
                            <TextBlock Text="Memory Status" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <!-- Total Memory -->
                            <Border Grid.Column="0" Grid.Row="0"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Total Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding MemoryInfo.TotalPhysical, StringFormat='{}{0:F1} GB'}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Available Memory -->
                            <Border Grid.Column="1" Grid.Row="0"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Available Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding MemoryInfo.AvailablePhysical, StringFormat='{}{0:F1} GB'}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="LightGreen"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Used Memory -->
                            <Border Grid.Column="0" Grid.Row="1"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Used Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding MemoryInfo.UsedPhysical, StringFormat='{}{0:F1} GB'}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="#FFA500"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Usage Percentage -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Usage" 
                                               FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding MemoryInfo.UsagePercentage, StringFormat='{}{0:P1}'}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="#00D4FF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Memory Usage Progress Bar -->
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Memory usage" 
                                           FontSize="12" Opacity="0.7"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding MemoryInfo.UsagePercentage, StringFormat='{}{0:P1}'}" 
                                           FontSize="12" Opacity="0.7"/>
                            </Grid>
                            <ProgressBar Value="{Binding MemoryInfo.UsagePercentage}" 
                                         Maximum="1"
                                         Height="8"
                                         Background="#333"
                                         Foreground="#00D4FF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced Memory Optimization -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚡" FontSize="24"/>
                            <TextBlock Text="Advanced RAM Optimization" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <TextBlock Text="Optimize memory with configurable options to free RAM cache, paged and non-paged memory" 
                                   FontSize="12" Opacity="0.7" 
                                   TextWrapping="Wrap"/>
                        
                        <!-- Advanced Options -->
                        <Border Background="#0F0F23" 
                                CornerRadius="6" 
                                Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔧 Advanced Options" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="White"/>
                                
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Safe Options -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <CheckBox Content="🗑️ Garbage Collection" 
                                                  IsChecked="{Binding IncludeGarbageCollection}"
                                                  Foreground="White"/>
                                        <CheckBox Content="💾 System Cache" 
                                                  IsChecked="{Binding IncludeSystemCache}"
                                                  Foreground="White"/>
                                        <CheckBox Content="⚙️ Working Set" 
                                                  IsChecked="{Binding IncludeWorkingSet}"
                                                  Foreground="White"/>
                                    </StackPanel>
                                    
                                    <!-- Advanced Options -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <CheckBox Content="⏸️ Standby Memory" 
                                                  IsChecked="{Binding IncludeStandbyMemory}"
                                                  Foreground="White"/>
                                        <CheckBox Content="📄 Paged Pool (Risky)" 
                                                  IsChecked="{Binding IncludePagedPool}"
                                                  Foreground="#FFA500"/>
                                        <CheckBox Content="🔒 Non-Paged Pool (Risky)" 
                                                  IsChecked="{Binding IncludeNonPagedPool}"
                                                  Foreground="#FF4444"/>
                                    </StackPanel>
                                </Grid>
                                
                                <TextBlock Text="⚠️ Options marked 'Risky' may affect system stability" 
                                           FontSize="10" 
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="🚀 Optimize RAM" 
                                Command="{Binding OptimizeMemoryCommand}"
                                Background="#00D4FF"
                                Foreground="Black"
                                FontWeight="Bold"
                                FontSize="14"
                                Padding="20,12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"/>
                        
                        <ProgressBar IsVisible="{Binding IsCleaning}"
                                   IsIndeterminate="True"
                                   Background="#333"
                                   Foreground="#00D4FF"
                                   Height="6"/>
                    </StackPanel>
                </Border>

                <!-- Last Cleanup Result -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1"
                        IsVisible="{Binding LastCleanupResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📋 Last Result" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="{Binding LastCleanupResult.SpaceFreed, StringFormat='Space freed: {0:F1} MB'}" 
                                   FontSize="14" 
                                   Foreground="LightGreen"/>
                        <TextBlock Text="{Binding LastCleanupResult.Timestamp, StringFormat='Performed on: {0:dd/MM/yyyy HH:mm}'}" 
                                   FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Top Processes Panel -->
            <Border Grid.Column="1" 
                    Background="#1A1A2E" 
                    CornerRadius="8" 
                    Padding="20"
                    BorderBrush="#333" 
                    BorderThickness="1">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🔍" FontSize="20"/>
                        <TextBlock Text="Top Processes" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="White"/>
                    </StackPanel>
                    
                    <TextBlock Text="Processes using the most memory" 
                               FontSize="12" Opacity="0.7"/>
                    
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F0F23" 
                                            Padding="12" 
                                            Margin="0,4" 
                                            CornerRadius="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding MemoryUsage, StringFormat='{}{0:F1} MB'}" 
                                                           FontSize="10" 
                                                           Foreground="#AAAAAA"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" 
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" 
                                                           FontSize="10" 
                                                           Foreground="#666"/>
                                                <TextBlock Text="{Binding CpuUsage, StringFormat='CPU: {0:F1}%'}" 
                                                           FontSize="10" 
                                                           Foreground="#666"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Content="🔄 Refresh" 
                            Command="{Binding RefreshCommand}"
                            Background="#333" 
                            Foreground="White"
                            FontSize="12"
                            Padding="12,6"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#1A1A2E" 
                CornerRadius="6" 
                Margin="0,10,0,0" 
                Padding="15,10"
                BorderBrush="#333" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📡" FontSize="16"/>
                    <TextBlock Text="Real-time monitoring" 
                               FontSize="12" 
                               Foreground="White"/>
                    <TextBlock Text="{Binding IsMonitoring, Converter={x:Static BoolConverters.Not}, ConverterParameter=Stopped, FallbackValue=Active}" 
                               FontSize="12" 
                               Foreground="{Binding IsMonitoring, Converter={x:Static BoolConverters.Not}, ConverterParameter=#FF4444, FallbackValue=#00D4FF}"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="{Binding IsMonitoring, Converter={x:Static BoolConverters.Not}, ConverterParameter=Start, FallbackValue=Stop}" 
                        Command="{Binding ToggleMonitoringCommand}"
                        Background="#333" 
                        Foreground="White"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
