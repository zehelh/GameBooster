<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBooster.UI.Views.MemoryView">
    
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <Grid Margin="20">
             <Grid.RowDefinitions>
                 <RowDefinition Height="Auto"/>
                 <RowDefinition Height="*"/>
                 <RowDefinition Height="Auto"/>
             </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🧠 Memory Management" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Monitor and optimize system memory usage" 
                       FontSize="14" Opacity="0.7" 
                       Foreground="#CCCCCC"/>
        </StackPanel>

                 <!-- Main Content -->
         <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Memory Management Panel -->
            <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,10,0">
                
                <!-- Memory Status Card -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📊" FontSize="24"/>
                            <TextBlock Text="Memory Status" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <!-- Total Memory -->
                            <Border Grid.Column="0" Grid.Row="0"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Total Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                                                         <TextBlock Text="{Binding TotalMemoryFormatted}" 
                                                FontSize="18" FontWeight="Bold" 
                                                Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Available Memory -->
                            <Border Grid.Column="1" Grid.Row="0"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Available Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                                                         <TextBlock Text="{Binding AvailableMemoryFormatted}" 
                                                FontSize="18" FontWeight="Bold" 
                                                Foreground="LightGreen"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Used Memory -->
                            <Border Grid.Column="0" Grid.Row="1"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Used Memory" 
                                               FontSize="12" Opacity="0.7"/>
                                                                         <TextBlock Text="{Binding UsedMemoryFormatted}" 
                                                FontSize="18" FontWeight="Bold" 
                                                Foreground="#FFA500"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Usage Percentage -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Background="#0F0F23" 
                                    CornerRadius="6" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Usage" 
                                               FontSize="12" Opacity="0.7"/>
                                                                         <TextBlock Text="{Binding UsagePercentageFormatted}" 
                                                FontSize="18" FontWeight="Bold" 
                                                Foreground="#00D4FF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Memory Usage Progress Bar -->
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Memory usage" 
                                           FontSize="12" Opacity="0.7"/>
                                                                 <TextBlock Grid.Column="1" 
                                            Text="{Binding UsagePercentageFormatted}" 
                                            FontSize="12" Opacity="0.7"/>
                            </Grid>
                                                         <ProgressBar Value="{Binding UsagePercentageRatio}" 
                                          Maximum="1"
                                         Height="8"
                                         Background="#333"
                                         Foreground="#00D4FF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced Memory Optimization -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚡" FontSize="24"/>
                            <TextBlock Text="Advanced RAM Optimization" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <TextBlock Text="Optimize memory with configurable options to free RAM cache, paged and non-paged memory" 
                                   FontSize="12" Opacity="0.7" 
                                   TextWrapping="Wrap"/>
                        
                        <!-- Advanced Options -->
                        <Border Background="#0F0F23" 
                                CornerRadius="6" 
                                Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔧 Advanced Options" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="White"/>
                                
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Safe Options -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <CheckBox Content="🗑️ Garbage Collection" 
                                                  IsChecked="{Binding IncludeGarbageCollection}"
                                                  Foreground="White"/>
                                        <CheckBox Content="💾 System Cache" 
                                                  IsChecked="{Binding IncludeSystemCache}"
                                                  Foreground="White"/>
                                        <CheckBox Content="⚙️ Working Set" 
                                                  IsChecked="{Binding IncludeWorkingSet}"
                                                  Foreground="White"/>
                                    </StackPanel>
                                    
                                    <!-- Advanced Options -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <CheckBox Content="⏸️ Standby Memory" 
                                                  IsChecked="{Binding IncludeStandbyMemory}"
                                                  Foreground="White"/>
                                        <CheckBox Content="📄 Paged Pool (Risky)" 
                                                  IsChecked="{Binding IncludePagedPool}"
                                                  Foreground="#FFA500"/>
                                        <CheckBox Content="🔒 Non-Paged Pool (Risky)" 
                                                  IsChecked="{Binding IncludeNonPagedPool}"
                                                  Foreground="#FF4444"/>
                                    </StackPanel>
                                </Grid>
                                
                                <TextBlock Text="⚠️ Options marked 'Risky' may affect system stability" 
                                           FontSize="10" 
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="🚀 Optimize RAM" 
                                Command="{Binding OptimizeMemoryCommand}"
                                Background="#00D4FF"
                                Foreground="Black"
                                FontWeight="Bold"
                                FontSize="14"
                                Padding="20,12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"/>
                        
                        <ProgressBar IsVisible="{Binding IsCleaning}"
                                   IsIndeterminate="True"
                                   Background="#333"
                                   Foreground="#00D4FF"
                                   Height="6"/>
                    </StackPanel>
                </Border>

                <!-- Last Cleanup Result -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1"
                        IsVisible="{Binding LastCleanupResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="📋 Last Cleanup Results" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="White"/>
                        
                        <!-- Summary -->
                        <Border Background="#0F0F23" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding TotalMemoryFreedFormatted}" 
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="LightGreen"/>
                                <TextBlock Text="{Binding MemoryImprovementFormatted}" 
                                           FontSize="12"
                                           Foreground="#00D4FF"/>
                                <TextBlock Text="{Binding DurationFormatted}" 
                                           FontSize="12"
                                           Foreground="#AAAAAA"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Detailed Statistics -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <!-- Garbage Collection -->
                            <Border Grid.Column="0" Grid.Row="0" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Garbage Collection" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding GarbageCollectionFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- System Cache -->
                            <Border Grid.Column="1" Grid.Row="0" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="System Cache" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding SystemCacheFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Working Set -->
                            <Border Grid.Column="0" Grid.Row="1" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Working Set" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding WorkingSetFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Standby Memory -->
                            <Border Grid.Column="1" Grid.Row="1" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Standby Memory" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding StandbyMemoryFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Paged Pool -->
                            <Border Grid.Column="0" Grid.Row="2" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Paged Pool" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding PagedPoolFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Non-Paged Pool -->
                            <Border Grid.Column="1" Grid.Row="2" Background="#0F0F23" CornerRadius="4" Padding="8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Non-Paged Pool" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding NonPagedPoolFreedFormatted}" 
                                               FontSize="12" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Memory State -->
                        <Border Background="#0F0F23" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Memory State" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Before Cleanup" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="{Binding AvailableMemoryBeforeFormatted}" 
                                                   FontSize="11" Foreground="#FFA500"/>
                                        <TextBlock Text="{Binding MemoryUsageBeforeFormatted}" 
                                                   FontSize="11" Foreground="#FFA500"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="After Cleanup" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="{Binding AvailableMemoryAfterFormatted}" 
                                                   FontSize="11" Foreground="LightGreen"/>
                                        <TextBlock Text="{Binding MemoryUsageAfterFormatted}" 
                                                   FontSize="11" Foreground="LightGreen"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Process Cleanup Details -->
                        <Border Background="#0F0F23" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Cleanup Results" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding LastCleanupResult.ErrorMessage}" 
                                           FontSize="11" Foreground="LightGreen"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="{Binding LastCleanupResult.Timestamp}" 
                                   FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Top Processes Panel -->
            <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="8" Padding="20" BorderBrush="#333" BorderThickness="1">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#x1F50D;" FontSize="20"/>
                        <TextBlock Text="Top Processes" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    
                    <TextBlock Text="Processes using the most memory" FontSize="12" Opacity="0.7"/>
                    
                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F0F23" Margin="0,2" CornerRadius="4" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="12" Foreground="White"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryUsageMB}" FontSize="12" Foreground="#00D4FF"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

                 <!-- Status Bar -->
         <Border Grid.Row="2" 
                 Background="#1A1A2E" 
                 CornerRadius="6" 
                 Margin="0,10,0,0" 
                 Padding="15,10"
                 BorderBrush="#333" 
                 BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📡" FontSize="16"/>
                    <TextBlock Text="Real-time monitoring" 
                               FontSize="12" 
                               Foreground="White"/>
                    <TextBlock Text="{Binding MonitoringStatusText}" 
                               FontSize="12" 
                               Foreground="{Binding MonitoringStatusColor}"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="{Binding MonitoringButtonText}" 
                        Command="{Binding ToggleMonitoringCommand}"
                        Background="#333" 
                        Foreground="White"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="4"/>
                         </Grid>
         </Border>
     </Grid>
     </ScrollViewer>
 </UserControl>
