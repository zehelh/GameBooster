<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:GameBooster.Common.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GameBooster.UI.Views.SchedulerView">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⏰ Task Scheduler" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Schedule automatic system optimization tasks" 
                       FontSize="14" Opacity="0.7" 
                       Foreground="#CCCCCC"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Task List -->
            <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,10,0">
                
                <!-- Scheduled Tasks -->
                <Border Background="#1A1A2E" 
                        CornerRadius="8" 
                        Padding="20"
                        BorderBrush="#333" 
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" FontSize="24"/>
                            <TextBlock Text="Scheduled Tasks" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                        
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScheduledTask">
                                        <Border Background="#0F0F23" 
                                                Padding="15" 
                                                Margin="0,8" 
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                <!-- Task Info -->
                                                <StackPanel Grid.Column="0" Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="16" FontWeight="Bold" 
                                                               Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="12" Opacity="0.7"/>
                                                </StackPanel>
                                                
                                                <!-- Task Type -->
                                                <StackPanel Grid.Column="1" Grid.Row="0" 
                                                            HorizontalAlignment="Center" 
                                                            Margin="10,0">
                                                    <Border Background="#333" 
                                                            Padding="8,4" 
                                                            CornerRadius="4">
                                                        <TextBlock Text="{Binding Type}" 
                                                                   FontSize="10" FontWeight="Bold" 
                                                                   Foreground="#00D4FF"/>
                                                    </Border>
                                                </StackPanel>
                                                
                                                <!-- Task Status -->
                                                <StackPanel Grid.Column="2" Grid.Row="0" 
                                                            HorizontalAlignment="Right">
                                                    <Border Background="{Binding IsEnabled, Converter={x:Static BoolConverters.Not}, ConverterParameter=#4CAF50, FallbackValue=#FF4444}" 
                                                            Padding="8,4" 
                                                            CornerRadius="4">
                                                        <TextBlock Text="{Binding IsEnabled, Converter={x:Static BoolConverters.Not}, ConverterParameter=Enabled, FallbackValue=Disabled}" 
                                                                   FontSize="10" FontWeight="Bold" 
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                
                                                <!-- Task Schedule -->
                                                <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" 
                                                      ColumnDefinitions="*,Auto" 
                                                      Margin="0,10,0,0">
                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                        <TextBlock Text="Schedule" 
                                                                   FontSize="12" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding Schedule, StringFormat='{}{0}'}" 
                                                                   FontSize="12" 
                                                                   Foreground="#FFA500"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" 
                                                                HorizontalAlignment="Right" 
                                                                Orientation="Horizontal" 
                                                                Spacing="5">
                                                        <Button Content="Edit" 
                                                                Background="#333" 
                                                                Foreground="White"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                CornerRadius="4"/>
                                                        <Button Content="Delete" 
                                                                Background="#FF4444" 
                                                                Foreground="White"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                CornerRadius="4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                                                 <!-- Empty State -->
                         <Border Background="#0F0F23" 
                                 Padding="40" 
                                 CornerRadius="6">
                             <StackPanel HorizontalAlignment="Center" Spacing="10">
                                 <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                                 <TextBlock Text="No scheduled tasks" 
                                            FontSize="16" FontWeight="Bold" 
                                            Foreground="White"
                                            HorizontalAlignment="Center"/>
                                 <TextBlock Text="Create your first scheduled task to automate system optimization" 
                                            FontSize="12" Opacity="0.7" 
                                            HorizontalAlignment="Center"
                                            TextWrapping="Wrap"/>
                             </StackPanel>
                         </Border>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <!-- Memory Cleanup Task -->
                    <Border Grid.Column="0" Grid.Row="0"
                            Background="#1A1A2E" 
                            CornerRadius="8" 
                            Padding="20"
                            BorderBrush="#333" 
                            BorderThickness="1"
                            Margin="0,0,7.5,7.5">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🧠" FontSize="24"/>
                                <TextBlock Text="Memory Cleanup" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="White"/>
                            </StackPanel>
                            
                            <TextBlock Text="Schedule automatic memory optimization" 
                                       FontSize="12" Opacity="0.7" 
                                       TextWrapping="Wrap"/>
                            
                            <Button Content="Schedule" 
                                    Command="{Binding ScheduleMemoryCleanupCommand}"
                                    Background="#00D4FF"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    Padding="15,8"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk Cleanup Task -->
                    <Border Grid.Column="1" Grid.Row="0"
                            Background="#1A1A2E" 
                            CornerRadius="8" 
                            Padding="20"
                            BorderBrush="#333" 
                            BorderThickness="1"
                            Margin="7.5,0,0,7.5">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💾" FontSize="24"/>
                                <TextBlock Text="Disk Cleanup" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="White"/>
                            </StackPanel>
                            
                            <TextBlock Text="Schedule automatic disk space cleanup" 
                                       FontSize="12" Opacity="0.7" 
                                       TextWrapping="Wrap"/>
                            
                            <Button Content="Schedule" 
                                    Command="{Binding ScheduleDiskCleanupCommand}"
                                    Background="#FFA500"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    Padding="15,8"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- System Optimization Task -->
                    <Border Grid.Column="0" Grid.Row="1"
                            Background="#1A1A2E" 
                            CornerRadius="8" 
                            Padding="20"
                            BorderBrush="#333" 
                            BorderThickness="1"
                            Margin="0,7.5,7.5,0">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚡" FontSize="24"/>
                                <TextBlock Text="System Optimization" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="White"/>
                            </StackPanel>
                            
                            <TextBlock Text="Schedule complete system optimization" 
                                       FontSize="12" Opacity="0.7" 
                                       TextWrapping="Wrap"/>
                            
                            <Button Content="Schedule" 
                                    Command="{Binding ScheduleSystemOptimizationCommand}"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Padding="15,8"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Custom Task -->
                    <Border Grid.Column="1" Grid.Row="1"
                            Background="#1A1A2E" 
                            CornerRadius="8" 
                            Padding="20"
                            BorderBrush="#333" 
                            BorderThickness="1"
                            Margin="7.5,7.5,0,0">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔧" FontSize="24"/>
                                <TextBlock Text="Custom Task" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="White"/>
                            </StackPanel>
                            
                            <TextBlock Text="Create a custom scheduled task" 
                                       FontSize="12" Opacity="0.7" 
                                       TextWrapping="Wrap"/>
                            
                            <Button Content="Create" 
                                    Command="{Binding CreateCustomTaskCommand}"
                                    Background="#9C27B0"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Padding="15,8"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Task Management Panel -->
            <Border Grid.Column="1" 
                    Width="250"
                    Background="#1A1A2E" 
                    CornerRadius="8" 
                    Padding="20"
                    BorderBrush="#333" 
                    BorderThickness="1">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚙️" FontSize="20"/>
                        <TextBlock Text="Task Management" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="White"/>
                    </StackPanel>
                    
                    <TextBlock Text="Manage and monitor scheduled tasks" 
                               FontSize="12" Opacity="0.7"/>
                    
                    <Separator Margin="0,10"/>
                    
                    <StackPanel Spacing="10">
                        <Button Content="🔄 Refresh" 
                                Command="{Binding RefreshTasksCommand}"
                                Background="#333" 
                                Foreground="White"
                                FontSize="12"
                                Padding="12,8"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"/>
                        
                        <Button Content="▶️ Start All" 
                                Command="{Binding StartAllTasksCommand}"
                                Background="#4CAF50" 
                                Foreground="White"
                                FontSize="12"
                                Padding="12,8"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"/>
                        
                        <Button Content="⏸️ Pause All" 
                                Command="{Binding PauseAllTasksCommand}"
                                Background="#FFA500" 
                                Foreground="Black"
                                FontSize="12"
                                Padding="12,8"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"/>
                        
                        <Button Content="🗑️ Clear All" 
                                Command="{Binding ClearAllTasksCommand}"
                                Background="#FF4444" 
                                Foreground="White"
                                FontSize="12"
                                Padding="12,8"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                    <Separator Margin="0,10"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="📊 Statistics" 
                                   FontSize="14" FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="{Binding ScheduledTasks.Count, StringFormat='Active tasks: {0}'}" 
                                   FontSize="12" 
                                   Foreground="#00D4FF"/>
                        <TextBlock Text="{Binding EnabledTasksCount, StringFormat='Enabled: {0}'}" 
                                   FontSize="12" 
                                   Foreground="LightGreen"/>
                        <TextBlock Text="{Binding DisabledTasksCount, StringFormat='Disabled: {0}'}" 
                                   FontSize="12" 
                                   Foreground="#FFA500"/>
                    </StackPanel>
                    
                    <Separator Margin="0,10"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="💡 Tips" 
                                   FontSize="14" FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="• Schedule memory cleanup during idle time" 
                                   FontSize="11" Opacity="0.7" 
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Run disk cleanup weekly" 
                                   FontSize="11" Opacity="0.7" 
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Monitor task execution logs" 
                                   FontSize="11" Opacity="0.7" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#1A1A2E" 
                CornerRadius="6" 
                Margin="0,10,0,0" 
                Padding="15,10"
                BorderBrush="#333" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="⏰ Task scheduler ready" 
                           FontSize="12" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                
                <ProgressBar Grid.Column="1" 
                             IsIndeterminate="True" 
                             Width="100" Height="4"
                             IsVisible="{Binding IsLoading}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
